{
  "name": "kosno-gallery-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Galeria Jana Kosno — 3D v2 renderer (TypeGPU / WebGPU). Builds into ../v2/.",
  "scripts": {
    "dev": "vite",
